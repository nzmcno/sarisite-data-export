{
  "manifest_version": 3,
  "name": "İlan Veri İndirici: Sahibinden İlanlarını CSV'ye Aktar",
  "version": "1.8.1",
  "description": "Sahibinden ilanlarını CSV ve JSON olarak indirin. Emlak, vasıta ve tüm kategorilerde liste ve ilan sayfalarını dışa aktarın.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "alarms", "notifications", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": ["*://*.sahibinden.com/*"]
}
